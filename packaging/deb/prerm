#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop sensor-hub.service || true
            systemctl disable sensor-hub.service >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade)
        # postinst restarts the unit once the new binary is in place.
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
